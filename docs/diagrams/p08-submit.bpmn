<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P08" targetNamespace="urn:sec-unl:docs:p08">
<bpmn:process id="P08" name="Remitir versión de evidencia" isExecutable="false">
<bpmn:documentation>Modelo descriptivo derivado de SubmitEvidenceService. La compuerta sintetiza rechazo esperado; errores inesperados y rechazo temprano de autenticación se explican en la página de procesos. No es un motor ejecutable ni validación normativa BPMN completa.</bpmn:documentation>
<bpmn:laneSet id="Lanes"><bpmn:lane id="Responsible" name="Responsable documental"><bpmn:flowNodeRef>request</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="System" name="Backend SEC-UNL">
<bpmn:flowNodeRef>start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>auth</bpmn:flowNodeRef>
<bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gate</bpmn:flowNodeRef>
<bpmn:flowNodeRef>persist</bpmn:flowNodeRef>
<bpmn:flowNodeRef>done</bpmn:flowNodeRef>
<bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
<bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
</bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="start" name="Iniciar remisión"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="request" name="Solicitar remisión"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="auth" name="Autenticar y autorizar solicitud"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="validate" name="Validar revisión, estado, fuentes y cobertura"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gate" name="¿Validación satisfactoria?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="persist" name="Persistir remisión y registrar auditoría"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="done" name="Completar remisión"><bpmn:incoming>f5</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="reject" name="Comunicar error sin remitir"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="failed" name="Finalizar con rechazo"><bpmn:incoming>f7</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f0" sourceRef="start" targetRef="request" name=""/>
<bpmn:sequenceFlow id="f1" sourceRef="request" targetRef="auth" name=""/>
<bpmn:sequenceFlow id="f2" sourceRef="auth" targetRef="validate" name=""/>
<bpmn:sequenceFlow id="f3" sourceRef="validate" targetRef="gate" name=""/>
<bpmn:sequenceFlow id="f4" sourceRef="gate" targetRef="persist" name="Sí"/>
<bpmn:sequenceFlow id="f5" sourceRef="persist" targetRef="done" name=""/>
<bpmn:sequenceFlow id="f6" sourceRef="gate" targetRef="reject" name="No"/>
<bpmn:sequenceFlow id="f7" sourceRef="reject" targetRef="failed" name=""/>
</bpmn:process>
