{
  "info": {
    "name": "SIGEAC - API local",
    "description": "Ejecutar completa y en orden con el entorno local. Comprueba sesión, consultas, validación, CSRF y CORS. Solo modifica sesiones y auditoría.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "csrf",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 204) {",
          "  pm.test('Sin contenido', () => pm.expect(pm.response.text()).to.eql(''));",
          "} else {",
          "  pm.test('Respuesta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "  pm.test('Contrato de respuesta', () => {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.all.keys('success', 'message', 'data', 'errors', 'meta');",
          "    pm.expect(body.success).to.eql(pm.response.code < 400);",
          "    pm.expect(body.message).to.be.a('string').and.not.empty;",
          "    pm.expect(body.meta).to.be.an('object');",
          "    if (body.success) pm.expect(body.errors).to.eql(null);",
          "    else { pm.expect(body.data).to.eql(null); pm.expect(body.errors.code).to.be.a('string').and.not.empty; }",
          "  });",
          "}",
          "pm.test('Identificador de correlación', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.be.a('string').and.not.empty);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Acceso sin sesión",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{baseOrigin}}"
          }
        ],
        "url": "{{baseUrl}}/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Código de error', () => pm.expect(pm.response.json().errors.code).to.eql('AUTHENTICATION_REQUIRED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Validación del ingreso con mismo origen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{baseOrigin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sessions",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Código de error', () => pm.expect(pm.response.json().errors.code).to.eql('VALIDATION_FAILED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Rechazo de origen externo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "https://untrusted.example"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sessions",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('Código de error', () => pm.expect(pm.response.json().errors.code).to.eql('CORS_DENIED'));",
              "pm.test('Origen externo sin autorización CORS', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).not.to.eql('https://untrusted.example'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03b - Preflight de origen externo",
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "https://untrusted.example"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "POST"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "content-type,x-csrf-token"
          }
        ],
        "url": "{{baseUrl}}/sessions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('Código de error', () => pm.expect(pm.response.json().errors.code).to.eql('CORS_DENIED'));",
              "pm.test('Origen externo sin autorización CORS', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).not.to.eql('https://untrusted.example'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Ingreso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{baseOrigin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Cookie de sesión HttpOnly', () => pm.expect(pm.response.headers.get('Set-Cookie')).to.match(/HttpOnly/i));",
              "pm.test('Token CSRF', () => pm.expect(pm.response.json().data.csrfToken).to.be.a('string').and.not.empty);",
              "if (pm.response.code === 201) pm.variables.set('csrf', pm.response.json().data.csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Identidad autenticada",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{baseOrigin}}"
          }
        ],
        "url": "{{baseUrl}}/me"
