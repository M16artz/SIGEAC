        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Página acotada', () => { const body = pm.response.json(); pm.expect(body.data.items).to.be.an('array'); pm.expect(body.data.items.length).to.be.at.most(5); pm.expect(body.meta.size).to.eql(5); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Carreras",
      "request": {
        "method": "GET",
