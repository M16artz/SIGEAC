SEC_DB_URL=jdbc:postgresql://localhost:5432/sec_unl
SEC_DB_USER=sec_app
SEC_DB_PASSWORD=change-locally
SEC_FILE_ROOT=./var/files
SEC_DEMO_DATA=true
SEC_AUTH_HMAC_SECRET=replace-with-at-least-32-random-characters
SEC_COOKIE_SECURE=false
SEC_TEST_DB_URL=jdbc:postgresql://localhost:5432/sec_unl_test
SEC_TEST_DB_USER=sec_test
SEC_TEST_DB_PASSWORD=change-locally
SEC_RUN_DATABASE_TESTS=false
SEC_USE_TESTCONTAINERS=false

# HTTP/API: local development remains bound to loopback by default.
SEC_BIND_ADDRESS=127.0.0.1
SEC_REQUIRE_HTTPS=false
SEC_CORS_ALLOWED_ORIGINS=
SEC_REQUESTS_PER_MINUTE=600
SEC_MAX_RATE_LIMIT_CLIENTS=10000
# prod requires a real PKCS12 keystore; do not commit its password or private key.
SEC_TLS_KEY_STORE=
SEC_TLS_KEY_STORE_PASSWORD=
SEC_HTTPS_PORT=8443
# Optional external OIDC. The signed sub must identify an enabled local UUID.
SEC_OIDC_ENABLED=false
SEC_OIDC_ISSUER_URI=
SEC_OIDC_JWK_SET_URI=
SEC_OIDC_AUDIENCE=
