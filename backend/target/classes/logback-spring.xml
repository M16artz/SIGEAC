<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="SAFE_PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{correlationId:-none}] %logger{36} - %replace(%msg){'(?i)(password|authorization|cookie|token)=([^,\\s]+)','$1=[REDACTED]'}%n"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${SAFE_PATTERN}</pattern></encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
