{
  "name": "@testing-library/angular",
  "version": "19.6.0",
  "description": "Test your Angular components with the dom-testing-library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testing-library/angular-testing-library.git"
  },
  "keywords": [
    "angular",
    "ngx",
    "ng",
    "typescript",
    "angular2",
    "test",
    "dom-testing-library"
  ],
  "author": "Tim Deschryver",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/testing-library/angular-testing-library/issues"
  },
  "homepage": "https://github.com/testing-library/angular-testing-library#readme",
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "devDependencies"
  },
  "ng-update": {
    "migrations": "./schematics/migrations/migrations.json"
  },
  "peerDependencies": {
    "@angular/router": ">= 21.0.0",
    "@angular/core": ">= 21.0.0",
    "@testing-library/dom": "^10.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "fesm2022/testing-library-angular.mjs",
  "typings": "types/testing-library-angular.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/testing-library-angular.d.ts",
      "default": "./fesm2022/testing-library-angular.mjs"
    },
    "./jest-utils": {
      "types": "./types/testing-library-angular-jest-utils.d.ts",
      "default": "./fesm2022/testing-library-angular-jest-utils.mjs"
    },
    "./vitest-utils": {
      "types": "./types/testing-library-angular-vitest-utils.d.ts",
      "default": "./fesm2022/testing-library-angular-vitest-utils.mjs"
    },
    "./zone": {
      "types": "./types/testing-library-angular-zone.d.ts",
      "default": "./fesm2022/testing-library-angular-zone.mjs"
    },
    "./zoneless": {
      "types": "./types/testing-library-angular-zoneless.d.ts",
      "default": "./fesm2022/testing-library-angular-zoneless.mjs"
    }
  },
  "sideEffects": false,
  "type": "module"
}
